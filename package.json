{
  "name": "tab-land",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: usage-ordered tabs, Jev-powered use-case groups, and lineage-aware dedupe.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "e2e": "node tests/e2e.mjs",
    "icons": "node scripts/build-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/robin-anil/tab-land.git"
  },
  "engines": {
    "node": ">=20"
  }
}
